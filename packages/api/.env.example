# API Package Configuration
# Copy this file to .env.local and fill in the actual values for local development

# DynamoDB Configuration
# The name of the DynamoDB table that will be created and managed by CDK
DYNAMODB_TABLE_NAME=career-compass-conversations

# Bedrock Configuration
# AWS region where Bedrock is available (e.g., us-east-1, us-west-2)
BEDROCK_REGION=us-east-1

# Bedrock Model ID
# The Claude model to use for AI interactions. Use an inference profile ARN format for Bedrock models.
# Example: us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock Generation Parameters
# Temperature controls the randomness of the output. Higher values (e.g., 0.8) make output more random, 
# while lower values (e.g., 0.2) make it more focused and deterministic.
BEDROCK_TEMPERATURE=0.7

# Maximum number of tokens for the default response generation. Adjust based on your needs and model limits.
BEDROCK_MAX_TOKENS_DEFAULT=1024

# Maximum number of tokens for synthesis tasks, which may require more tokens than regular responses. 
BEDROCK_MAX_TOKENS_SYNTHESIS=3072

# Conversation Configuration
# The maximum number of turns to keep in the conversation history for context. 
# Older turns will be dropped when this limit is exceeded.
CONVERSATION_MAX_TURNS=10

# Node Environment
# Optional: defaults to 'development' if not set
NODE_ENV=development
