{
  "name": "@career-compass/infra",
  "version": "0.2.0",
  "description": "Infrastructure and deployment configuration",
  "private": true,
  "type": "module",
  "bin": {
    "career-compass-cdk": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk:deploy": "cdk deploy --require-approval never",
    "cdk:deploy:all": "cdk deploy --all --require-approval never",
    "cdk:destroy": "cdk destroy --force",
    "cdk:destroy:all": "cdk destroy --all --force",
    "precdk:synth": "npm run build",
    "cdk:synth": "cdk synth",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf coverage dist cdk.out"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "aws-cdk": "2.1144.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "vitest": "5.0.3"
  }
}
