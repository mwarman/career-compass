# Infrastructure (CDK) Configuration
# Copy this file to .env.local if you need to set any environment-specific CDK context values

# CDK will use AWS credentials from:
# - AWS_PROFILE environment variable
# - ~/.aws/credentials file
# - IAM instance profile (if running on EC2)
#
# Do NOT store secrets in this file. Use AWS Secrets Manager or Parameter Store instead.
SESSION_TABLE_NAME=career-compass-sessions
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_TEMPERATURE=0.7
BEDROCK_MAX_TOKENS_DEFAULT=1024
BEDROCK_MAX_TOKENS_SYNTHESIS=3072
CONVERSATION_MAX_TURNS=10