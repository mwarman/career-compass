{
  "name": "@career-compass/infra",
  "version": "0.1.0",
  "description": "Infrastructure and deployment configuration",
  "private": true,
  "type": "module",
  "bin": {
    "career-compass-cdk": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy --all --require-approval never",
    "cdk:destroy": "cdk destroy --all --force",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest --silent",
    "test:coverage": "jest --coverage --silent",
    "clean": "rimraf coverage dist cdk.out"
  },
  "dependencies": {
    "aws-cdk-lib": "2.253.1",
    "constructs": "10.6.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "25.6.2",
    "aws-cdk": "2.1121.0",
    "esbuild": "0.28.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.9"
  }
}
