{
  "type": "module",
  "name": "career-compass",
  "version": "0.1.0",
  "description": "A conversational AI application that guides professionals through a structured but adaptive multi-turn dialogue to assess their current skills, surface career goals, identify skill gaps, and produce a prioritized upskilling recommendation.",
  "keywords": [
    "ai",
    "aws",
    "bedrock",
    "lambda",
    "typescript"
  ],
  "author": "Matthew Warman",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwarman/career-compass.git"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web",
    "packages/infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0"
  }
}
